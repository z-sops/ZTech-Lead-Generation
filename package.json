{
  "name": "phone-global-leads",
  "version": "1.0.0",
  "description": "phone全球获客",
  "author": "",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,green \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --dir --config.win.signAndEditExecutable=false",
    "test": "node tests/run-all.js",
    "test:list": "node tests/run-all.js --list",
    "lint": "eslint . --max-warnings 100000",
    "lint:strict": "eslint . --max-warnings 0",
    "lint:report": "eslint . --format json",
    "check:repo": "node scripts/check-repo.js",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=moderate",
    "verify": "npm run check:repo && npm run lint && npm test && npm run audit:prod"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "33.4.11",
    "electron-builder": "^26.15.3",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "electron-store": "^8.0.1",
    "sql.js": "^1.10.3"
  },
  "build": {
    "appId": "com.whatsapp.automation",
    "productName": "phone全球获客",
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "package.json",
      "src/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "directories": {
      "output": "dist"
    }
  }
}
